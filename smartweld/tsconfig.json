{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
